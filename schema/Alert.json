{
  "entity": "Alert",
  "description": "Review-queue item generated by the reconciliation engine or system checks",
  "fields": {
    "vehicle_id": {"type": "string", "ref": "Vehicle.id"},
    "owner_id": {"type": "string", "ref": "User.id"},
    "type": {"type": "string", "enum": ["revenue_discrepancy", "fuel_outlier", "sync_issue", "agreement_expiring", "payment_due"]},
    "severity": {"type": "string", "enum": ["low", "medium", "high"]},
    "message": {"type": "string", "description": "human-readable, never accusatory, e.g. 'KSh 2044 discrepancy ... requires review'"},
    "requires_review": {"type": "boolean"},
    "is_read": {"type": "boolean"},
    "is_demo": {"type": "boolean"}
  }
}
